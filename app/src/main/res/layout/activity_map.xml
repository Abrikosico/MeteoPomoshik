<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardBack"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:cardCornerRadius="25dp"
        app:cardElevation="6dp"
        android:layout_margin="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackground"
            app:tint="#505050"
            android:padding="12dp"
            android:scaleType="fitCenter"/>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardLayers"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:cardCornerRadius="25dp"
        app:cardElevation="6dp"
        android:layout_margin="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton
            android:id="@+id/btnLayers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_layers"
            android:background="?attr/selectableItemBackground"
            app:tint="#505050"
            android:padding="12dp"
            android:scaleType="fitCenter"/>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/layoutZoom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:cardCornerRadius="25dp"
            app:cardElevation="6dp"
            android:layout_marginBottom="24dp"> <ImageButton
            android:id="@+id/btnMyLocation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_my_location"
            android:background="?attr/selectableItemBackground"
            android:padding="12dp"
            android:scaleType="fitCenter"/>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:cardCornerRadius="25dp"
            app:cardElevation="6dp"
            android:layout_marginBottom="16dp">
            <ImageButton
                android:id="@+id/btnZoomIn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_plus"
                android:background="?attr/selectableItemBackground"
                android:padding="12dp"
                android:scaleType="fitCenter"/>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:cardCornerRadius="25dp"
            app:cardElevation="6dp">
            <ImageButton
                android:id="@+id/btnZoomOut"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_minus"
                android:background="?attr/selectableItemBackground"
                android:padding="12dp"
                android:scaleType="fitCenter"/>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#CC2c3e50"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:id="@+id/tvLegend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Слой: Атмосферное давление"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"/>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>